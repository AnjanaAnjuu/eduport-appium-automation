    ],
    "day": {
      "locator": [
        "xpath",
        "//*[@content-desc='Date Of Birth']/following-sibling::android.view.View[1]"
      ],
      "attribute": "content-desc"
    },
    "month": {
      "locator": [
        "xpath",
        "//*[@content-desc='Date Of Birth']/following-sibling::android.view.View[2]"
      ],
      "attribute": "content-desc"
    },
    "year": {
      "locator": [
        "xpath",
        "//*[@content-desc='Date Of Birth']/following-sibling::android.view.View[3]"
      ],
      "attribute": "content-desc"
    },
    "year_current": {
      "locator": [
        "accessibility id",
        "2026"
      ],
      "attribute": "content-desc"
    }
  },
